<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="save_my_eyes.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Save my Eyes">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">

        <Grid.Resources>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="CardBrush" Color="#0DFFFFFF"/>
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B4FFFFFF"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="BreakBrush" Color="#FF3CB371"/>

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E60078D4"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CC0078D4"/>
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#E60078D4"/>
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#CC0078D4"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragArea"
            Grid.Row="0"
            Height="36"
            Background="Transparent"/>

        <Grid
            Grid.Row="1"
            Padding="32,8,32,8"
            MaxWidth="584"
            RowSpacing="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                VerticalAlignment="Center"
                Height="260"
                Padding="28,0"
                CornerRadius="12"
                BorderThickness="1"
                Background="{StaticResource CardBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                <StackPanel Spacing="16" VerticalAlignment="Center">

                    <TextBlock
                        x:Name="TimerText"
                        Text="{x:Bind ViewModel.DisplayTime, Mode=OneWay}"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        FontSize="88"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"/>

                    <ProgressBar
                        Minimum="0"
                        Maximum="100"
                        Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                        Foreground="{StaticResource AccentBrush}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Time remaining in this phase"/>

                    <TextBlock
                        Text="{x:Bind ViewModel.SessionHint, Mode=OneWay}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        MinHeight="60"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite"/>

                </StackPanel>
            </Border>

            <StackPanel
                Grid.Row="1"
                Spacing="8"
                HorizontalAlignment="Center">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    HorizontalAlignment="Center">

                    <Button
                        Command="{x:Bind ViewModel.ToggleCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Width="96"
                        Height="48"
                        AutomationProperties.Name="{x:Bind ViewModel.ToggleLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ToggleLabel, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.ToggleGlyph, Mode=OneWay}" FontSize="22"/>
                    </Button>

                    <Button
                        Command="{x:Bind ViewModel.ResetCommand}"
                        Width="48"
                        Height="48"
                        AutomationProperties.Name="Reset"
                        ToolTipService.ToolTip="Reset">
                        <FontIcon Glyph="&#xE72C;" FontSize="18"/>
                    </Button>

                </StackPanel>

                <HyperlinkButton
                    Content="Take a break now"
                    Command="{x:Bind ViewModel.TakeBreakNowCommand}"
                    HorizontalAlignment="Center"/>

            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,16,16">

            <TextBlock
                Text="{x:Bind ViewModel.BreaksText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.BreaksVisibility, Mode=OneWay}"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"/>

            <Button
                Click="SettingsButton_Click"
                HorizontalAlignment="Right"
                AutomationProperties.Name="Settings">

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="16"/>
                    <TextBlock Text="Settings"/>
                </StackPanel>
            </Button>

        </Grid>

    </Grid>
</Window>
